{
  "name": "vid2skill",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "dev:web": "pnpm --filter @vid2skill/web dev",
    "cli": "pnpm --filter @vid2skill/cli start"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.32.1"
}
