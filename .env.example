# Copy this to apps/web/.env.local (web app) or .env in your working directory
# (CLI) and fill in real values. Never commit the filled-in file.

# https://supadata.ai — free tier: 100 credits/month
SUPADATA_API_KEY=

# https://openrouter.ai/keys — pipeline uses OpenRouter free models (openrouter/free cascade)
OPENROUTER_API_KEY=

# https://console.upstash.com — Redis REST URL + token (free tier). Required by apps/web only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# https://cloud.umami.is — optional, apps/web only. Omit to disable analytics.
UMAMI_WEBSITE_ID=
